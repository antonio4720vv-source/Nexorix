# Copia este archivo a ".env" (NO lo subas a git) y cargalo antes de arrancar el backend:
#   Linux/macOS:  set -a; source .env; set +a
#   PowerShell:   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim().Trim('"')) } }
#   IntelliJ:     Run > Edit Configurations > Environment variables (o el plugin EnvFile)

# ---------- PostgreSQL ----------
NEXORIX_DB_URL=jdbc:postgresql://localhost:5432/nexorix
NEXORIX_DB_USER=postgres
NEXORIX_DB_PASSWORD=cambia-esta-clave

# ---------- Didit (verificacion de identidad). Con el usuario "demo" del seed puedes poner cualquier texto ----------
DIDIT_API_KEY=pon-cualquier-texto-si-usas-el-seed
DIDIT_WORKFLOW_ID=pon-cualquier-texto-si-usas-el-seed
DIDIT_WEBHOOK_SECRET=

# ---------- Bancos en vivo (webhook firmado) ----------
# Genera uno con:  openssl rand -hex 32
BANK_WEBHOOK_SECRET=
NEXORIX_BANK_DEMO=true

# ---------- WhatsApp Cloud API (Meta). Vacio = modo demo (solo log) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=inventa-un-texto-largo
WHATSAPP_BUSINESS_PHONE=
WHATSAPP_TEMPLATE_NAME=

# ---------- SMS (Twilio). Vacio = modo demo ("[DEMO SMS]" en el log) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Defensa por IP ----------
# Reportar IPs atacantes a AbuseIPDB (clave gratis en https://www.abuseipdb.com/account/api). Vacio = no reporta.
ABUSEIPDB_API_KEY=
# IPs que nunca se banean (separadas por coma). Ponla aqui si probaras los honeypots desde tu propia red.
NEXORIX_BAN_ALLOWLIST=

# ---------- IA (opcional) ----------
GEMINI_API_KEY=

# ---------- Direccion publica (ngrok) para los webhooks ----------
NEXORIX_PUBLIC_URL=http://localhost:8080
